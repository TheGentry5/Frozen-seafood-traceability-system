<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.frozen_seafood_traceability_system.mapper.FarmBatchMapper">
    <!-- 待补充：selectPageForNode（docs/开发实施文档.md 附录 D） -->

    <!-- 养殖可选批号（已发布 2） -->
    <select id="selectReleasedByNode" resultType="com.example.frozen_seafood_traceability_system.entity.FarmBatch">
        SELECT id, batch_code, product_name FROM farm_batch
        WHERE node_id = #{nodeId} AND status = 2 ORDER BY create_time DESC
    </select>
</mapper>
